{
  "en": {
    "summary": "Cloud tools and authorization",
    "usage": "swcl help [depth|path [depth]]",
    "details": [
      "swcl help 2                         #List commands",
      "swcl auth/setup                     #Open authorization",
      "swcl cloudflare/cli <args>          #Run Cloudflare CLI",
      "swcl cloudflare/wrangler <args>     #Run Wrangler",
      "swcl tencent/cli <args>             #Run Tencent Cloud CLI",
      "swcl edgeone/cli <args>             #Run EdgeOne CLI",
      "swcl base/node/ensure              #Prepare Node/npm",
      "swcl base/uv/ensure                #Prepare uv"
    ]
  },
  "zh": {
    "summary": "云工具与授权",
